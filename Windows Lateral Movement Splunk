index=main (sourcetype=WinEventLog:Security OR sourcetype=XmlWinEventLog:Microsoft-Windows-Sysmon/Operational)
    (

        EventID=4624 OR EventID=4672
    )
    OR
    (

        EventID=5140
    )
    OR
    (
      
        EventID=4688 OR EventID=1
        (NewProcessName="*\\powershell.exe" OR NewProcessName="*\\wmic.exe" OR NewProcessName="*\\mstsc.exe" OR NewProcessName="*\\cmd.exe")
    )
    | eval MITRE_ATTCK_CASE = case(
        EventID=5140, "T1021.001 - SMB/Windows Admin Shares",
        match(NewProcessName, ".*mstsc.*"), "T1021.002 - Remote Desktop Protocol",
        match(NewProcessName, ".*wmic.*"), "T1047 - Windows Management Instrumentation",
        match(NewProcessName, ".*powershell.*"), "T1071.001 - Application Layer Protocol"
    )
   
    | eval parent_child_flag = if(
        (ParentProcessName="*\\winword.exe" AND like(NewProcessName,"%powershell%")) OR
        (ParentProcessName="*\\powershell.exe" AND like(NewProcessName,"%wmic%")) OR
        (ParentProcessName="*\\cmd.exe" AND like(NewProcessName,"%mstsc%")), 1, 0
    )

    | eventstats avg(count) as avg_events stdev(count) as stdev_events by host, Account_Name
    | eval anomaly_score = if(count > avg_events + 3*stdev_events, 1, 0)
    | eval total_risk_score = anomaly_score + parent_child_flag
    | stats count, dc(TargetHost) as hosts_accessed, values(NewProcessName) as processes, values(ParentProcessName) as parent_processes, values(Account_Name) as accounts, sum(parent_child_flag) as parent_child_flag, sum(anomaly_score) as anomaly_score, sum(total_risk_score) as total_risk_score by host
    | where total_risk_score > 1
    | table _time, host, accounts, processes, parent_processes, hosts_accessed, MITRE_ATTCK_CASE, anomaly_score, parent_child_flag, total_risk_score
    | sort -total_risk_score
